{
  "expo": {
    "name": "My Language Baddy",
    "slug": "my-language-baddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drissguessous.mylanguagebaddy",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "My Language Baddy écoute votre voix pour analyser votre prononciation.",
        "NSSpeechRecognitionUsageDescription": "La reconnaissance vocale permet de vérifier ce que vous dites.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drissguessous.mylanguagebaddy",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "My Language Baddy",
      "themeColor": "#0F766E",
      "backgroundColor": "#F7F6F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "My Language Baddy écoute votre voix pour analyser votre prononciation.",
          "speechRecognitionPermission": "La reconnaissance vocale permet de vérifier ce que vous dites.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "scheme": "mylanguagebaddy",
    "description": "Apprendre 11 langues à l'oral et à l'écrit, du niveau A1 au C2, avec un compagnon humain adapté à l'âge.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/My-language-baddy"
    }
  }
}